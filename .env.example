# Supabase project used for appointment and contact requests.
# Copy this file to .env and fill in the values for your project.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The browser client uses the VITE_-prefixed copies of the same values.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional: only needed for trusted server-side admin queries that bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=""
